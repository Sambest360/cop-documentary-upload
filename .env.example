# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# From Google Cloud → APIs & Services → Credentials (OAuth client, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by `npm run setup-google`
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# A long random secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Your site's address(es), comma separated, no trailing slash. Only these may use the API.
ALLOWED_ORIGINS=https://your-project.vercel.app

# Optional: largest photo allowed, in MB (default 25)
MAX_FILE_MB=25

# Optional but recommended: Cloudflare Turnstile bot protection (free). Leave empty to turn off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
